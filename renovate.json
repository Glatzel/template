{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":maintainLockFilesMonthly"
  ],
  "schedule": [
    "* * 1 * *"
  ],
  "enabledManagers": [
    "cargo",
    "devcontainer",
    "docker-compose",
    "git-submodules",
    "github-actions",
    "npm",
    "nuget",
    "pixi",
    "rust-toolchain"
  ],
  "commitMessagePrefix": "build:",
  "git-submodules": {
    "enabled": true
  },
  "packageRules": [
    {
      "groupName": "GitHub Actions",
      "matchManagers": [
        "github-actions"
      ]
    },
    {
      "groupName": "Pixi",
      "matchManagers": [
        "pixi"
      ],
      "registryUrls": [
        "https://prefix.dev/glatzel/",
        "https://prefix.dev/conda-forge/"
      ]
    },
    {
      "description": "Disable update python and numpy",
      "matchManagers": [
        "pixi"
      ],
      "matchPackageNames": [
        "python",
        "numpy"
      ],
      "enabled": false
    },
    {
      "description": "lefthook",
      "matchManagers": [
        "pixi"
      ],
      "matchFileNames": [
        ".github/actions/lefthook/**"
      ]
    },
    {
      "groupName": "Cargo",
      "matchManagers": [
        "cargo"
      ],
      "rangeStrategy": "bump"
    },
    {
      "groupName": "Rust Toolchain",
      "matchManagers": [
        "rust-toolchain"
      ],
      "rangeStrategy": "pin"
    },
    {
      "groupName": "Dotnet",
      "matchManagers": [
        "nuget"
      ]
    },
    {
      "groupName": "git-submodules",
      "matchManagers": [
        "git-submodules"
      ]
    },
    {
      "groupName": "npm",
      "matchManagers": [
        "npm"
      ]
    }
  ]
}
